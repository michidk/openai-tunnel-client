#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
install_dir=${1:-"${repo_root}/.tools/bin"}
version=0.7.0

case $(uname -m) in
  x86_64)
    architecture=amd64
    checksum=c31518ddd122663b3f3aa874cfe8178cb0988de944f29c74a0b9260920d115d3
    ;;
  aarch64 | arm64)
    architecture=arm64
    checksum=cc907ccf9e3c34523f0f32b69745265e0a6908ca85b92f41931d4537860eb83c
    ;;
  *)
    echo "unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

binary=${install_dir}/kubeconform
if [[ -x ${binary} ]] && [[ $(${binary} -v) == *"${version}"* ]]; then
  exit 0
fi

download_dir=$(mktemp -d)
trap 'rm -rf "${download_dir}"' EXIT
archive=${download_dir}/kubeconform.tar.gz
curl --fail --location --silent --show-error \
  "https://github.com/yannh/kubeconform/releases/download/v${version}/kubeconform-linux-${architecture}.tar.gz" \
  --output "${archive}"
printf '%s  %s\n' "${checksum}" "${archive}" | sha256sum --check --status
tar -xzf "${archive}" -C "${download_dir}" kubeconform
mkdir -p "${install_dir}"
install -m 0755 "${download_dir}/kubeconform" "${binary}"
